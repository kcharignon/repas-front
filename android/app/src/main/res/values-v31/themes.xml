<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- L'écran de lancement d'Android 12 et plus : fond basilic, feuille de l'icône (aucune image externe). -->
    <style name="Theme.Repas" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/basil</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
