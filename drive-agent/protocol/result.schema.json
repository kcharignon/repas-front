{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Message de l'agent du drive vers Repas (protocole v1) : result et setup-result",
  "description": "Source de vérité documentaire (architecture.md § 8 du dépôt back). Les validateurs de drive-agent/protocol font foi à l'exécution ; un test vérifie qu'ils donnent le même verdict que ce schéma. Ce que JSON Schema ne sait pas dire (identifiants de produit sans doublon dans rejected, adresse de base cohérente avec l'hôte et l'identifiant du magasin d'un setup-result) n'est vérifié que par les validateurs.",
  "type": "object",
  "required": ["v", "type", "runId", "agentVersion"],
  "oneOf": [
    {
      "additionalProperties": false,
      "required": ["outcome", "lines"],
      "properties": {
        "v": true,
        "runId": true,
        "agentVersion": true,
        "type": { "const": "result" },
        "outcome": { "enum": ["completed", "partial", "aborted", "error"] },
        "store": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": { "id": { "$ref": "#/definitions/storeId" } }
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "$ref": "#/definitions/errorCode" },
            "message": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        },
        "stats": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requests", "errors", "blocks"],
          "properties": {
            "requests": { "$ref": "#/definitions/counter" },
            "errors": { "$ref": "#/definitions/counter" },
            "blocks": { "$ref": "#/definitions/counter" }
          }
        },
        "lines": { "type": "array", "maxItems": 100, "items": { "$ref": "#/definitions/line" } }
      },
      "if": { "properties": { "outcome": { "const": "error" } } },
      "then": { "required": ["error"] }
    },
    {
      "additionalProperties": false,
      "required": ["store"],
      "properties": {
        "v": true,
        "runId": true,
        "agentVersion": true,
        "type": { "const": "setup-result" },
        "store": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "host", "baseUrl", "label"],
          "properties": {
            "id": { "$ref": "#/definitions/storeId" },
            "host": { "type": "string", "minLength": 1, "maxLength": 255 },
            "baseUrl": { "type": "string", "minLength": 1 },
            "label": { "oneOf": [{ "$ref": "#/definitions/label" }, { "type": "null" }] }
          },
          "oneOf": [
            {
              "description": "Un magasin de Leclerc : l'identifiant est numérique et se lit dans l'adresse.",
              "properties": {
                "id": { "type": "string", "pattern": "^[0-9]{1,12}$" },
                "host": { "type": "string", "pattern": "^[a-z0-9-]+\\.leclercdrive\\.fr$" },
                "baseUrl": {
                  "type": "string",
                  "pattern": "^https://[a-z0-9-]+\\.leclercdrive\\.fr/magasin-[0-9]{1,12}-[0-9]{1,12}$"
                }
              }
            },
            {
              "description": "Un magasin d'Auchan : l'identifiant est un UUID lu par l'agent, l'adresse de base est une constante de l'enseigne.",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "host": { "type": "string", "const": "www.auchan.fr" },
                "baseUrl": { "type": "string", "const": "https://www.auchan.fr/" }
              }
            }
          ]
        }
      }
    }
  ],
  "properties": {
    "v": { "const": 1 },
    "runId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "agentVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
  },
  "definitions": {
    "label": { "type": "string", "minLength": 1, "maxLength": 255 },
    "storeId": {
      "description": "Un résultat ne dit pas l'enseigne : l'identifiant a la forme de l'un de ceux des enseignes (STORES.id).",
      "type": "string",
      "pattern": "^[0-9]{1,12}$|^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "counter": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "catalogId": {
      "description": "Facultatif (DRV-642) : le rayon ou la famille du produit choisi chez l'enseigne.",
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "productId": {
      "description": "Un résultat ne dit pas l'enseigne : l'identifiant a la forme de l'un de ceux des enseignes (STORES.productId).",
      "type": "string",
      "pattern": "^[0-9]{1,12}$|^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "errorCode": {
      "enum": [
        "NOT_LOGGED_IN",
        "STORE_MISMATCH",
        "BLOCKED",
        "CONTRACT_CHANGED",
        "NETWORK",
        "CANCELLED",
        "INVALID_MESSAGE",
        "UNSUPPORTED_PAGE"
      ]
    },
    "quantity": { "type": "integer", "minimum": 1, "maximum": 99 },
    "searchQuery": {
      "description": "Facultatif (DRV-650), sur une ligne CHOSEN : la recherche qui a fait apparaître le produit choisi, de 2 à 80 caractères (points de code). Le nettoyage (caractères de contrôle et invisibles, espaces) est fait par l'agent et revérifié par le site.",
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "notInCart": {
      "description": "Facultatif (DRV-742), sur une ligne CHOSEN : vrai quand le panier de l'enseigne n'a rien pris de ce produit (le choix de la personne est quand même enregistré). Absente = au panier (agents d'avant compris). Jamais false.",
      "const": true
    },
    "packSize": {
      "description": "Facultatif (DRV-652), sur une ligne ADDED ou CHOSEN : la contenance du produit dans l'unité de la ligne du plan (needed.unitSlug), donnée par la personne à l'écran « Vérifie la quantité ». Valeur de 0,001 à 9999, trois décimales au plus (le schéma ne sait pas le dire, les validateurs le vérifient). Pour un CHOSEN, seulement en PRIMARY.",
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unitSlug"],
      "properties": {
        "value": { "type": "number", "minimum": 0.001, "maximum": 9999 },
        "unitSlug": { "type": "string", "pattern": "^[a-z0-9-]{1,255}$" }
      }
    },
    "unavailableIds": {
      "description": "Au plus 4 pour ADDED (le produit mis au panier n'en fait pas partie), 5 sinon.",
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/productId" }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "enum": ["g", "kg", "ml", "cl", "l", "piece"] }
      }
    },
    "ean": { "type": ["string", "null"], "pattern": "^[0-9]{8,14}$" },
    "price": {
      "description": "Prix TTC en centimes, avec le prix à l'unité de mesure quand l'agent l'a lu (décision D22).",
      "type": "object",
      "additionalProperties": false,
      "required": ["cents"],
      "properties": {
        "cents": { "type": "integer", "minimum": 0, "maximum": 100000000 },
        "perMeasure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cents", "unit"],
          "properties": {
            "cents": { "type": "integer", "minimum": 0, "maximum": 100000000 },
            "unit": { "enum": ["kg", "l", "piece"] }
          }
        }
      }
    },
    "rejectedProduct": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/definitions/productId" },
        "label": { "$ref": "#/definitions/label" },
        "ean": { "$ref": "#/definitions/ean" },
        "content": { "$ref": "#/definitions/content" }
      }
    },
    "chosenProduct": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/definitions/productId" },
        "label": { "$ref": "#/definitions/label" },
        "ean": { "$ref": "#/definitions/ean" },
        "content": { "$ref": "#/definitions/content" },
        "price": { "$ref": "#/definitions/price" },
        "rayonId": { "$ref": "#/definitions/catalogId" },
        "familyId": { "$ref": "#/definitions/catalogId" },
        "offerId": {
          "description": "Facultatif (DRV-722) : l'identifiant de l'offre du produit choisi dans le magasin. Un résultat ne dit pas l'enseigne : sa forme est celle de l'une des enseignes qui ont une offre (StoreRules.offerId : l'UUID d'Auchan) ; la clé est interdite tant qu'aucune enseigne n'en a, ce que seuls les validateurs voient.",
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      }
    },
    "line": {
      "type": "object",
      "required": ["ingredientSlug", "outcome"],
      "properties": {
        "ingredientSlug": { "type": "string", "pattern": "^[a-z0-9-]{1,100}$" },
        "outcome": {
          "enum": ["ADDED", "CHOSEN", "HAVE_AT_HOME", "SKIPPED", "UNAVAILABLE", "FAILED"]
        },
        "rejected": {
          "description": "Les produits que l'utilisateur a choisi de ne plus jamais prendre, sans doublon.",
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/definitions/rejectedProduct" }
        }
      },
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["productId", "quantity", "usedRank"],
          "properties": {
            "ingredientSlug": true,
            "rejected": true,
            "outcome": { "const": "ADDED" },
            "productId": { "$ref": "#/definitions/productId" },
            "quantity": { "$ref": "#/definitions/quantity" },
            "usedRank": { "type": "integer", "minimum": 1, "maximum": 5 },
            "price": { "$ref": "#/definitions/price" },
            "packSize": { "$ref": "#/definitions/packSize" },
            "unavailableIds": {
              "allOf": [
                { "$ref": "#/definitions/unavailableIds" },
                { "type": "array", "maxItems": 4 }
              ]
            }
          }
        },
        {
          "additionalProperties": false,
          "required": ["product", "quantity", "placement"],
          "properties": {
            "ingredientSlug": true,
            "rejected": true,
            "outcome": { "const": "CHOSEN" },
            "product": { "$ref": "#/definitions/chosenProduct" },
            "quantity": { "$ref": "#/definitions/quantity" },
            "placement": { "enum": ["PRIMARY", "FALLBACK", "ONCE"] },
            "searchQuery": { "$ref": "#/definitions/searchQuery" },
            "notInCart": { "$ref": "#/definitions/notInCart" },
            "packSize": { "$ref": "#/definitions/packSize" },
            "unavailableIds": { "$ref": "#/definitions/unavailableIds" }
          }
        },
        {
          "additionalProperties": false,
          "properties": {
            "ingredientSlug": true,
            "rejected": true,
            "outcome": { "const": "UNAVAILABLE" },
            "unavailableIds": { "$ref": "#/definitions/unavailableIds" }
          }
        },
        {
          "additionalProperties": false,
          "properties": {
            "ingredientSlug": true,
            "rejected": true,
            "outcome": { "enum": ["HAVE_AT_HOME", "SKIPPED"] }
          }
        },
        {
          "additionalProperties": false,
          "required": ["error"],
          "properties": {
            "ingredientSlug": true,
            "rejected": true,
            "outcome": { "const": "FAILED" },
            "error": { "$ref": "#/definitions/errorCode" }
          }
        }
      ]
    }
  }
}
