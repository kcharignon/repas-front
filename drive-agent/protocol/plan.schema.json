{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Message de Repas vers l'agent du drive (protocole v1) : plan et setup",
  "description": "Source de vérité documentaire (architecture.md § 8 du dépôt back). Les validateurs de drive-agent/protocol font foi à l'exécution ; un test vérifie qu'ils donnent le même verdict que ce schéma. Ce que JSON Schema ne sait pas dire (identifiants de produit sans doublon dans products et dans rejected, aucun produit à la fois dans products et dans rejected, ingredientSlug uniques entre les lignes) n'est vérifié que par les validateurs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "type", "runId", "retailer", "returnPath"],
  "properties": {
    "v": { "const": 1 },
    "type": { "enum": ["plan", "setup"] },
    "runId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "retailer": { "const": "leclerc" },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "host"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9]{1,12}$" },
        "host": { "type": "string", "pattern": "^[a-z0-9-]+\\.leclercdrive\\.fr$" }
      }
    },
    "returnPath": { "const": "/drive/retour" },
    "lines": {
      "description": "Obligatoire pour un plan, interdit pour un setup.",
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/definitions/line" }
    }
  },
  "if": { "properties": { "type": { "const": "plan" } } },
  "then": { "required": ["lines", "store"] },
  "else": { "not": { "required": ["lines"] } },
  "definitions": {
    "label": { "type": "string", "minLength": 1, "maxLength": 255 },
    "productId": { "type": "string", "pattern": "^[0-9]{1,12}$" },
    "productRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/definitions/productId" },
        "label": { "$ref": "#/definitions/label" }
      }
    },
    "product": {
      "description": "Un produit accepté, avec ses propres packs (les contenus diffèrent d'un produit à l'autre).",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/definitions/productId" },
        "label": { "$ref": "#/definitions/label" },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "unit"],
          "properties": {
            "value": { "type": "number", "exclusiveMinimum": 0 },
            "unit": { "enum": ["g", "kg", "ml", "cl", "l", "piece"] }
          }
        },
        "packs": { "type": ["integer", "null"], "minimum": 1, "maximum": 99 },
        "packsStatus": { "enum": ["COMPUTED", "TO_CHECK", null] }
      }
    },
    "needed": {
      "description": "Ce que la liste demande pour l'ingrédient, dans l'unité de la ligne. dimension et baseFactor permettent à l'agent de calculer le nombre de produits d'un produit qu'il ne connaissait pas.",
      "type": "object",
      "additionalProperties": false,
      "required": ["quantity", "unitSymbol"],
      "properties": {
        "quantity": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 },
        "unitSymbol": { "type": "string", "minLength": 1, "maxLength": 32 },
        "dimension": { "enum": ["WEIGHT", "VOLUME", "COUNT", "PACKAGE", null] },
        "baseFactor": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1000000 }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ingredientSlug", "name", "status"],
      "properties": {
        "ingredientSlug": { "type": "string", "pattern": "^[a-z0-9-]{1,100}$" },
        "name": { "$ref": "#/definitions/label" },
        "status": { "enum": ["KNOWN", "NEW", "HAVE_AT_HOME", "SKIP"] },
        "products": {
          "description": "Classés par priorité (le premier est préféré), sans doublon.",
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/definitions/product" }
        },
        "rejected": {
          "description": "Les produits que l'utilisateur ne veut jamais.",
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/definitions/productRef" }
        },
        "searchQuery": { "$ref": "#/definitions/label" },
        "replaces": { "$ref": "#/definitions/productRef" },
        "needed": { "$ref": "#/definitions/needed" },
        "rayonHints": {
          "description": "Facultatif (DRV-642) : les rayons de l'enseigne où l'on prend d'habitude cet ingrédient, du plus choisi au moins choisi. Sert à ranger la liste de l'écran de choix ; aucun produit n'est caché.",
          "type": "array",
          "maxItems": 3,
          "items": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "KNOWN" } } },
          "then": {
            "required": ["products"],
            "properties": { "products": { "type": "array", "minItems": 1 } }
          }
        },
        {
          "if": { "properties": { "status": { "const": "NEW" } } },
          "then": { "properties": { "products": { "type": "array", "maxItems": 0 } } }
        }
      ]
    }
  }
}
