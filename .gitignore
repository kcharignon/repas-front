# Application Android « Repas Drive » (android/) : sorties de Gradle et fichiers locaux du SDK. Aucune clé de publication
# n'entre dans le dépôt : seule debug.keystore (clé de débogage publique) est suivie.
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/core/build/
android/buildSrc/.gradle/
android/buildSrc/.kotlin/
android/buildSrc/build/
android/local.properties
android/*.jks
android/*.p12
android/*.pfx
android/**/*.keystore
!android/debug.keystore

# Réglages locaux et secrets : tout fichier .env.local*, .env.*.local*, à n'importe quelle profondeur, reste hors du dépôt (.env.example reste suivi)
.env.local*
.env.*.local*
# Marqueur Windows laissé par un fichier copié
*:Zone.Identifier
