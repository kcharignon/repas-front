{
  "extends": "./tsconfig.app.json",
  // Banc d'essai du favori (outil jetable, drive-agent/lab) : le code du favori, ses tests et son outil de construction.
  "include": ["drive-agent/lab/**/*.ts", "drive-agent/android-lab/**/*.ts", "android/**/*.ts", "env.d.ts"],
  "exclude": ["drive-agent/lab/dist/**", "drive-agent/android-lab/dist/**", "android/dist/**"],
  "compilerOptions": {
    "types": ["node"],
    // Les tests de android/ importent l'outil de construction de l'agent (drive-agent/scripts/build.mjs, JavaScript typé par JSDoc).
    "allowJs": true,
    // Le favori tourne dans une page web : DOM complet, y compris les cadres.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lab.tsbuildinfo"
  }
}
