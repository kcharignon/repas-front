{
  "extends": "./tsconfig.agent.json",
  // Les tests et l'outil de construction de l'agent : mêmes règles strictes, types de Node permis (ils ne partent pas dans l'agent).
  "include": [
    "drive-agent/src/**/*.ts",
    "drive-agent/protocol/**/*.ts",
    "drive-agent/test/**/*.ts",
    "drive-agent/demo/**/*.ts",
    "drive-agent/fake-leclerc/**/*.ts",
    "drive-agent/e2e/**/*.ts",
    "drive-agent/scripts/**/*.mjs"
  ],
  "compilerOptions": {
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.agent-test.tsbuildinfo"
  }
}
