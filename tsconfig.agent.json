{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  // L'agent du drive (drive-agent/src) : TypeScript strict, DOM seul. Aucun type de Node : le code tourne dans une page web.
  "include": ["drive-agent/src/**/*.ts", "drive-agent/protocol/**/*.ts"],
  "compilerOptions": {
    "types": [],
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.agent.tsbuildinfo"
  }
}
